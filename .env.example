# --- Entorno y Seguridad HTTPS ---
ENVIRONMENT=production
FORCE_HTTPS=true

# --- Base de Datos y Bucket en la Nube (Supabase / PostgreSQL) ---
# Obtén estos valores en tu panel de Supabase -> Project Settings -> API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_supabase_anon_o_service_role_key
SUPABASE_BUCKET=incident-evidence
DATABASE_URL=postgresql://postgres:password@db.tu-proyecto.supabase.co:5432/postgres
BLOB_READ_WRITE_TOKEN=tu_vercel_blob_token_aqui

# --- Roboflow Inference Model IDs ---
ROBOFLOW_API_KEY=tu_api_key_aqui
MODEL_ID_VEHICULOS=vehicle-qq0yh/2
MODEL_ID_PLACAS=vehicle-registration-plates-trudk/2
MODEL_ID_FUEGO=fire-detection-for-khkt/3

# --- Configuración de Dispositivo y Umbrales ---
DEVICE=cpu
CONFIDENCE_THRESHOLD=0.45
IOU_THRESHOLD=0.50

# --- Configuración de Alertas (Fase 4) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
TWILIO_TO_PHONE=

# --- APIs de Enriquecimiento (Fase 3) ---
OPENWEATHER_API_KEY=
MAPS_API_KEY=
RAPIDAPI_KEY=

# --- Microservicio de Enriquecimiento Situacional y Despacho ---
ENRICHMENT_SERVICE_URL=https://titan-enrichment-microservice.onrender.com
ENRICHMENT_SERVICE_API_KEY=titan-secret-key-2026
