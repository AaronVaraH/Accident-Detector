# ==============================================================================
# Variables de Entorno del Microservicio de Enriquecimiento y Despacho (Plantilla)
# Copia este archivo como .env y edita los valores correspondientes.
# NUNCA subas el archivo .env real al repositorio.
# ==============================================================================

# Configuración del Servidor REST
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8001
LOG_LEVEL=INFO
ENVIRONMENT=development

# Clave Secreta para Autenticación de Endpoints Críticos (Header X-API-Key)
SERVICE_API_KEY=titan-secret-key-2026
ENRICHMENT_SERVICE_API_KEY=titan-secret-key-2026

# Consumo de API de Terceros: OpenWeatherMap (Opcional, cuenta con fallback automático a Open-Meteo)
OPENWEATHER_API_KEY=tu_openweathermap_api_key_aqui
WEATHER_REQUEST_TIMEOUT=3.0
