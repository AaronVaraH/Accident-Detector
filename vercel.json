{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/pwa/$1"
    },
    {
      "source": "/manifest.json",
      "destination": "/pwa/manifest.json"
    },
    {
      "source": "/sw.js",
      "destination": "/pwa/sw.js"
    },
    {
      "source": "/historial",
      "destination": "/pwa/historial.html"
    },
    {
      "source": "/(.*)",
      "destination": "/pwa/$1"
    }
  ]
}
